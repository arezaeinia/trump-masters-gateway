{
  "name": "Execute Game Command",
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/games/([0-9]+)/commands",
    "headers": {
      "X-Gateway-Request": {
        "equalTo": "true"
      },
      "Content-Type": {
        "contains": "application/json"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "game-command-success.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
